# ArcRelay environment configuration
#
# Leave everything below commented out to run in fully offline MOCK mode —
# the Agent Wallet, USDC balance, and x402 signatures are all synthesized
# locally, no Circle credentials or network access required.
#
# Set ARCRELAY_FORCE_MOCK=1 to force mock mode even if a private key is
# present below (useful for demos in Codespaces).
ARCRELAY_FORCE_MOCK=1

# --- Live mode (real Circle Gateway settlement via @circle-fin/x402-batching) ---
# An EVM private key for the orchestrator's buyer wallet. Fund it with
# testnet USDC from https://faucet.circle.com, then deposit into the
# Gateway Wallet (GatewayClient.deposit(...)) before payments will settle.
# ARCRELAY_PRIVATE_KEY=0x...

# USDC contract address on Arc L1 testnet. Defaults to the real address
# (0x3600000000000000000000000000000000000000) if unset.
# ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000

# Payee address the mock sub-agent nodes charge to.
# ARCRELAY_SELLER_ADDRESS=0x...

# Override Circle Gateway's testnet API base URL if needed.
# ARCRELAY_GATEWAY_URL=https://gateway-api-testnet.circle.com

