# ArcRelay environment configuration
#
# Leave everything below commented out to run in fully offline MOCK mode —
# the Agent Wallet, USDC balance, and x402 signatures are all synthesized
# locally, no Circle credentials required.
#
# Set ARCRELAY_FORCE_MOCK=1 to force mock mode even if the Circle
# credentials below are present (useful for demos in Codespaces).
ARCRELAY_FORCE_MOCK=1

# --- Live mode (Circle Developer-Controlled Wallets on Arc L1 testnet) -----
# CIRCLE_API_KEY=
# CIRCLE_ENTITY_SECRET=
# ARC_USDC_ADDRESS=0x...
# ARCRELAY_SELLER_ADDRESS=0x...
