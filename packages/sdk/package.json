{
  "name": "@arcrelay/sdk",
  "version": "0.1.0",
  "description": "Drop-in x402 middleware and buyer client for Arc L1 / Circle Gateway nanopayments — protect any Express route with one line, pay for any protected resource with one call.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "keywords": [
    "x402",
    "arc",
    "circle",
    "gateway",
    "usdc",
    "agents",
    "micropayments"
  ],
  "dependencies": {
    "@circle-fin/x402-batching": "^3.2.0",
    "@x402/core": "^2.19.0",
    "@x402/evm": "^2.19.0",
    "viem": "^2.55.8"
  },
  "peerDependencies": {
    "express": ">=4"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "express": "^4.21.0",
    "tsx": "^4.23.1",
    "typescript": "^5.5.0"
  }
}
